# Compose-level template. Every value below is substituted into docker-compose.yml,
# which also pins the variables the API needs but nobody should tune per deployment
# (DATABASE_URL, PORT, STORAGE_DIR, MINIO_ENDPOINT, MINIO_BUCKET, MINIO_USE_SSL).

# Internal PostgreSQL credentials. docker-compose.yml carries defaults, so an
# empty file still boots — override them for anything reachable from outside.
POSTGRES_USER=nuage
POSTGRES_PASSWORD=nuage-internal-db
# POSTGRES_DB=nuage

# MinIO credentials, shared by the storage service and the API. The API refuses
# to start without them: every file it stores goes through MinIO.
MINIO_ACCESS_KEY=nuage-minio
MINIO_SECRET_KEY=nuage-internal-storage

# Required — presigned URL signing secret. The API exits 1 without it, because
# presigned download links are unauthenticated and forgeable if it is guessable.
# Generate with: openssl rand -base64 36
PRESIGN_SECRET=

# Optional — deployment name: development, staging, production
# APP_ENV=production

# Optional — debug, info, warn, error
# LOG_LEVEL=info

# Optional — comma-separated CORS origins. Unset denies every cross-origin caller,
# which is correct for the single-container deployment: the client is same-origin.
# CORS_ALLOWED_ORIGINS is the canonical name; ALLOWED_ORIGINS still works.
# ALLOWED_ORIGINS=

# OIDC (optional — leave empty to use email/password auth). Enabling OIDC_ISSUER
# makes the other four required.
# OIDC_ISSUER=https://porte.facile.studio/application/o/nuage/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://nuage.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://nuage.facile.studio
# SSO_ONLY=false

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL
# http://journal-api:4010/api on la ruche). The URL must end in /api.
# JOURNAL_URL=http://journal-api:4010/api
# JOURNAL_TOKEN=journal_nuage_...
