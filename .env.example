# Compose-level template. Every value below is substituted into docker-compose.yml,
# which also pins the variables the API needs but nobody should tune per deployment
# (DATABASE_URL, PORT, STORAGE_DIR, MINIO_ENDPOINT, MINIO_BUCKET, MINIO_USE_SSL).

# Internal PostgreSQL credentials. docker-compose.yml carries defaults, so an
# empty file still boots — override them for anything reachable from outside.
POSTGRES_USER=nuage
POSTGRES_PASSWORD=nuage-internal-db
# POSTGRES_DB=nuage

# MinIO credentials, shared by the storage service and the API. The API refuses
# to start without them: every file it stores goes through MinIO.
MINIO_ACCESS_KEY=nuage-minio
MINIO_SECRET_KEY=nuage-internal-storage

# Required — presigned URL signing secret. The API exits 1 without it, because
# presigned download links are unauthenticated and forgeable if it is guessable.
# Generate with: openssl rand -base64 36
PRESIGN_SECRET=

# Optional — deployment name: development, staging, production
# APP_ENV=production

# Optional — debug, info, warn, error
# LOG_LEVEL=info

# Optional — comma-separated CORS origins. Unset denies every cross-origin caller,
# which is correct for the single-container deployment: the client is same-origin.
# CORS_ALLOWED_ORIGINS is the canonical name; ALLOWED_ORIGINS still works.
# ALLOWED_ORIGINS=

# OIDC (Registre). People sign in through Registre only; without an issuer nobody can sign
# in. Setting OIDC_ISSUER makes the other four required.
# OIDC_ISSUER=https://porte.facile.studio/application/o/nuage/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://nuage.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://nuage.facile.studio
# The client id the suite CLI's device-grant token carries. Setting it mounts
# POST /api/auth/oidc/device/exchange; unset, that route does not exist.
# OIDC_CLI_AUDIENCE=facile-cli
# Nuage's own client id. Setting it lets a delegated JWT that Registre minted
# for another suite service (Bulle) act for a signed-in user. With the prefix
# set, GET needs nuage.read or nuage.write and every other method nuage.write.
# OIDC_MACHINE_AUDIENCE=
# OIDC_SCOPE_PREFIX=nuage
# NUAGE_APPS registers the suite apps that get a private app folder per user,
# as key:registre_client_id[:Display name] entries separated by ";". Needs
# OIDC_MACHINE_AUDIENCE: an app acts only through a delegated Registre JWT
# whose act.sub is its client id.
# NUAGE_APPS=plume:<plume client id>:Plume;ardoise:<ardoise client id>:Ardoise
# NUAGE_FULL_ACCESS_ACTORS lists the Registre client ids whose delegated JWTs
# (token exchange, act.sub) may use the user's whole drive. Any other actor that
# is not a registered app is refused everywhere. Bulle needs to be listed.
# NUAGE_FULL_ACCESS_ACTORS=bulle
# BULLE_URL turns on the Ideas page: Bulle generates and runs suggestions as the
# signed-in user (needs OIDC, PORTE_TOKEN_KEY and audience bulle in Registre).
# BULLE_URL=https://bulle.facile.studio
# MCP_RESOURCE turns on the MCP server at /mcp: the URL people paste into an MCP
# client, registered in Registre's seed (needs OIDC and PRESIGN_SECRET).
# MCP_RESOURCE=https://nuage.facile.studio/mcp

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL
# http://journal-api:4010/api on la ruche). The URL must end in /api.
# JOURNAL_URL=http://journal-api:4010/api
# JOURNAL_TOKEN=journal_nuage_...
