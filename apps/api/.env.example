# Browser origins allowed to call the API directly. Empty means same-origin only.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgres://nuage:nuage-internal-db@localhost:5432/nuage?sslmode=disable
PORT=4000
LOG_LEVEL=info

# MinIO / S3 storage (localhost for local dev — services run in Docker)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nuage-minio
MINIO_SECRET_KEY=nuage-internal-storage
MINIO_BUCKET=nuage
MINIO_USE_SSL=false

# Presigned URL signing secret. REQUIRED — the API refuses to start without it.
# Anyone who knows this value can forge unauthenticated download links for any
# file, so generate a fresh one: openssl rand -base64 36
PRESIGN_SECRET=change-me-openssl-rand-base64-36

# OIDC (optional — enable to use Authentik or any OpenID Connect provider)
# OIDC_ISSUER=https://authentik.yourdomain.com/application/o/nuage/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=http://localhost:3000/api/auth/oidc/callback
# OIDC_SUCCESS_URL=http://localhost:3000
# OIDC_MACHINE_AUDIENCE=your-client-id
# OIDC_SCOPE_PREFIX=nuage
# NUAGE_APPS registers the suite apps that get a private app folder per user,
# as key:registre_client_id[:Display name] entries separated by ";". Needs
# OIDC_MACHINE_AUDIENCE: an app acts only through a delegated Registre JWT
# whose act.sub is its client id.
# NUAGE_APPS=plume:<plume client id>:Plume;ardoise:<ardoise client id>:Ardoise
# NUAGE_FULL_ACCESS_ACTORS lists the Registre client ids whose delegated JWTs
# (token exchange, act.sub) may use the user's whole drive. Any other actor that
# is not a registered app is refused everywhere. Bulle needs to be listed.
# NUAGE_FULL_ACCESS_ACTORS=bulle
# BULLE_URL turns on the Ideas page: Bulle generates and runs suggestions as the
# signed-in user (needs OIDC, PORTE_TOKEN_KEY and audience bulle in Registre).
# BULLE_URL=https://bulle.facile.studio

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL http://journal-api:4010 on la ruche)
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_nuage_...
